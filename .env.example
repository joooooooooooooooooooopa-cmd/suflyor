# Suflyor reads plain environment variables (no .env loader); export them before launching.
# Path to the LLM CLI that speaks stream-json over stdin/stdout. Empty = look up `llm-cli` in PATH.
SUFLYOR_BRAIN_BIN=
# Model alias passed as --model to the main (questions) process. Empty = "smart".
SUFLYOR_BRAIN_MODEL=
# --effort for the main process. Unset = "low"; empty or "default" = do not pass the flag.
# SUFLYOR_BRAIN_EFFORT=low
# Transcription language for whisper: ru (default), en, auto, ...
SUFLYOR_LANG=
# Folder with prompts/ and briefs/ (overrides the app bundle resources).
SUFLYOR_HOME=
# 1 = write the session log (contains call text) to ~/Library/Logs/Suflyor/debug.log
SUFLYOR_DEBUG=
# Build time only: folder with your own briefs to bundle into the app.
BRIEFS_DIR=
